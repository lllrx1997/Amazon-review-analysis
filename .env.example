# Copy to .env. Never put these secrets in frontend public variables.
BRIGHT_DATA_API_KEY=
BRIGHT_DATA_DATASET_ID=
# Confirm these fields against YOUR scraper input schema before using.
# Input is combined with the server-generated Amazon URL. No date window by default.
BRIGHT_DATA_INPUT_JSON={"numOfReviews":100}
# Set only when the actual scraper supports a verified latest-first sort field.
# Example fields must come from your Bright Data console, not guessed here.
BRIGHT_DATA_QUERY_JSON={}
BRIGHT_DATA_LATEST_VERIFIED=false
BRIGHT_DATA_LIMIT_VERIFIED=false
# unknown, parent_page, child_only or mixed; describes verified scraper behavior.
BRIGHT_DATA_SCOPE=unknown
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=
MAX_REVIEWS=100
MAX_ACTIVE_ANALYSES=1
RESULT_TTL_SECONDS=7200
TASK_TIMEOUT_SECONDS=1200
PROVIDER_POLL_SECONDS=5
LLM_BATCH_CHARACTERS=12000
LLM_MAX_TOKENS=8192
# AI 分析批次的并发数，默认3；遇到限流时降为1或2，不是同时分析的ASIN数量。
LLM_CONCURRENCY=3
# 每批模型调用最多尝试次数，默认2；已有可核验结果时优先保留，不整批重做。
LLM_MAX_ATTEMPTS=2
# 单次模型 HTTP 调用超时，单位秒；默认90。
LLM_TIMEOUT_SECONDS=90
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
